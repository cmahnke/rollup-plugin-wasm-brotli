{
  "name": "@projektemacher/rollup-plugin-wasm-brotli",
  "version": "0.1.0",
  "description": "Locate and bundle WASM dependencies inline using brotli-unicode",
  "type": "module",
  "bin": {
    "compress": "dist/compress.js"
  },
  "license": "MIT",
  "peerDependencies": {
    "rollup": "^4.62.3"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "./dist/compress.mjs",
    "build": "npx rimraf dist/* && npx rollup -c",
    "test": "npx vitest",
    "clean": "npx rimraf dist/*",
    "lint": "npx tsc && npx eslint . -c eslint.config.mjs --report-unused-disable-directives --max-warnings 0",
    "knip": "npx knip",
    "jsdoc": "npx jsdoc -c jsdoc.config.json -r .",
    "format": "npx prettier . --check"
  },
  "dependencies": {
    "brotli-unicode": "latest",
    "rollup": "^4.62.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.1.2",
    "better-docs": "^2.7.3",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdoc": "^4.0.5",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "module": "./dist/es/index.js",
  "exports": {
    "types": "./types/index.d.ts",
    "import": "./dist/rollup-plugin-wasm-brotli.js"
  },
  "files": [
    "dist",
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "rollup",
    "plugin",
    "wasm",
    "brotli"
  ],
  "bugs": {
    "url": "https://github.com/cmahnke/rollup-plugin-wasm-brotli/issues"
  },
  "repository": {
    "url": "git+https://github.com/cmahnke/rollup-plugin-wasm-brotli.git"
  },
  "homepage": "https://github.com/cmahnke/rollup-plugin-wasm-brotli#readme"
}
